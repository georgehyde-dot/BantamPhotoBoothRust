# Use the official Rust image for ARM64 as a base.
FROM --platform=linux/arm64 rust:1.82-bookworm

# Set environment variables for pkg-config to find libcamera
ENV PKG_CONFIG_PATH="/usr/local/lib/aarch64-linux-gnu/pkgconfig:/usr/local/lib/pkgconfig:${PKG_CONFIG_PATH:-}"
ENV LD_LIBRARY_PATH="/usr/local/lib/aarch64-linux-gnu:/usr/local/lib:${LD_LIBRARY_PATH:-}"

# The official rust images sometimes run as root, so we still set up a non-root user
RUN useradd -ms /bin/bash builder
RUN chown -R builder:builder /home/builder
RUN chmod -R 755 /home/builder

# Install system dependencies needed for building libcamera and your Rust crates
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Build tools
    build-essential \
    cmake \
    ninja-build \
    pkg-config \
    python3-pip \
    python3-setuptools \
    python3-wheel \
    python3-yaml \
    python3-ply \
    python3-jinja2 \
    git \
    # libcamera dependencies
    libyaml-dev \
    python3-yaml \
    python3-ply \
    python3-jinja2 \
    openssl \
    libssl-dev \
    libgnutls28-dev \
    libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev \
    qtbase5-dev \
    libqt5core5a \
    libqt5gui5 \
    qttools5-dev \
    qttools5-dev-tools \
    libtiff-dev \
    # For rscam (fallback)
    libv4l-dev \
    # For printer support (CUPS)
    libcups2-dev \
    # For potential GUI/image processing libraries
    libfontconfig1-dev \
    libfreetype6-dev \
    # Clean up apt cache
    && rm -rf /var/lib/apt/lists/*

# Install meson (needed for libcamera build)
RUN pip3 install --break-system-packages meson

# Build libcamera from source
WORKDIR /tmp
RUN git clone https://git.libcamera.org/libcamera/libcamera.git
WORKDIR /tmp/libcamera

# Checkout a stable version (v0.4.0 tag)
RUN git checkout v0.4.0

# Configure the build
RUN meson setup build \
    --buildtype=release \
    -Dpipelines=rpi/vc4 \
    -Dipas=rpi/vc4 \
    -Dv4l2=true \
    -Dgstreamer=disabled \
    -Dqcam=disabled \
    -Dlc-compliance=disabled \
    -Dtest=false \
    -Ddocumentation=disabled

# Build and install libcamera
RUN ninja -C build
RUN ninja -C build install

# Update library cache
RUN ldconfig

# Set environment variables for pkg-config to find libcamera
ENV PKG_CONFIG_PATH="/usr/local/lib/aarch64-linux-gnu/pkgconfig:/usr/local/lib/pkgconfig:$PKG_CONFIG_PATH"
ENV LD_LIBRARY_PATH="/usr/local/lib/aarch64-linux-gnu:/usr/local/lib:$LD_LIBRARY_PATH"

# Clean up build directory to save space
RUN rm -rf /tmp/libcamera

# Switch to the non-root user
USER builder
WORKDIR /home/builder/project

# Set the default command to open a shell
CMD ["bash"]
